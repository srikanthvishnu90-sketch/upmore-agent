[Unit]
Description=Upmore career alerts scheduler (MI-032 host cycle; gauntlet test user scope)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/hatch/workspace/upmore-depth-int
Environment=http_proxy=http://hatch-egress-proxy:3128
Environment=https_proxy=http://hatch-egress-proxy:3128
Environment=HTTP_PROXY=http://hatch-egress-proxy:3128
Environment=HTTPS_PROXY=http://hatch-egress-proxy:3128
Environment=NODE_USE_ENV_PROXY=1
Environment=NODE_EXTRA_CA_CERTS=/run/hatch/egress-tls/ca-bundle.pem
Environment=SSL_CERT_FILE=/run/hatch/egress-tls/ca-bundle.pem
Environment=ALERTS_RUNTIME_DIR=/home/hatch/workspace/alerts-scheduler
ExecStart=/usr/bin/python3 /home/hatch/workspace/upmore-depth-int/scripts/career/alerts-scheduler-launch.py

[Install]
WantedBy=multi-user.target
