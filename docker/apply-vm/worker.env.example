# Copy to /etc/apply-vm/worker.env (chmod 600, root only). No secret is ever committed; fill these on the VM by hand.
SUPABASE_URL=https://<project-ref>.supabase.co
# A JWT for the apply_vm_worker role (scripts/launch/mint-apply-vm-jwt.cjs), NOT the service key. It can only run the vm functions.
APPLY_VM_KEY=<paste on the VM>
# Real employer hosts this VM may open. EMPTY for the dry run (mock forms on 127.0.0.1 only).
APPLY_VM_ALLOW_HOSTS=
# Engines at once on this VM. Set it: inside Docker the automatic figure reads the host memory, not the container limit (about 450 MB each; cores x 3 at most).
APPLY_VM_CONCURRENCY=4
# Round-robin share per person per claim round (1 = strict round-robin).
#APPLY_VM_PER_USER=1
# Optional politeness knobs; the default is none of ours (D-MS-2). A portal that refuses is held off automatically.
#APPLY_VM_HOST_MAX=
#APPLY_VM_HOST_SPACING_MS=
APPLY_VM_CHROMIUM_SANDBOX=on
