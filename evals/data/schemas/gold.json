{
 "file": "gold/drafts.json",
 "count_path": "conversations",
 "min_count": 1500,
 "unique_key": "id",
 "schema": {
  "type": "object",
  "required": [
   "schema_version",
   "generated_by",
   "review_policy",
   "conversations"
  ],
  "properties": {
   "conversations": {
    "type": "array",
    "items": {
     "type": "object",
     "required": [
      "id",
      "capability_id",
      "persona",
      "scenario",
      "assumes_status",
      "review",
      "principles",
      "turns"
     ],
     "properties": {
      "id": {
       "type": "string"
      },
      "capability_id": {
       "type": "string",
       "pattern": "^[A-Z]{3,4}-\\d{3}$"
      },
      "persona": {
       "type": "string",
       "enum": [
        "terse low-effort texter",
        "anxious first-timer",
        "detail-checker",
        "angry user mid-problem",
        "power user"
       ]
      },
      "scenario": {
       "type": "string",
       "enum": [
        "happy path",
        "missing data",
        "ambiguous input",
        "stale connector",
        "declined confirmation",
        "correction mid-flow",
        "gated capability",
        "not yet built",
        "watch fired",
        "outside envelope"
       ]
      },
      "assumes_status": {
       "type": "string",
       "enum": [
        "CLAIMED",
        "BUILT",
        "TESTED",
        "VERIFIED",
        "GATED",
        "NOT_WIRED"
       ]
      },
      "review": {
       "type": "string",
       "enum": [
        "reviewed",
        "unreviewed"
       ]
      },
      "principles": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "minItems": 1
      },
      "turns": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "object"
       }
      }
     }
    }
   }
  }
 }
}
