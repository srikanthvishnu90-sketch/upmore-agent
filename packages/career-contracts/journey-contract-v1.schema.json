      "type": "object",
      "properties": {
        "account_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "event_ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "account_version",
        "event_ordinal"
      ],
      "additionalProperties": false
    },
    "ContextBindingV1": {
      "type": "object",
      "properties": {
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "account_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "thread_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "context_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "epoch",
        "account_version",
        "thread_revision",
        "context_sha256"
      ],
      "additionalProperties": false
    },
