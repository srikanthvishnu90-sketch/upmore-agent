# upmore-career-board-measure.service — the MEASUREMENT board host.
#
# This unit runs the submit-disabled board service variant
# (workers/career-browser/board-service-measure.cjs), NOT the
# production board service. In the variant, every fill / answers /
# atReview / armForSubmit / submit / submissionState call is denied
# in code (MEASURE_HOST_METHOD_DISABLED) and the boards it creates
# are wrapped in a facade that does not expose those methods at all.
# There is no configuration — this file included — that re-opens a
# write path.
#
# Credential construction (the other half of the design):
# - The service runs as the dedicated UNPRIVILEGED user
#   trainee-measure, created by an owner-approved host step
#   (see scripts/career/systemd/README.md, "Measurement board host").
#   It is never root and never an omitted User= (systemd's default
#   is root).
# - There is NO EnvironmentFile. The executor's env file
#   (/home/hatch/worker-config/executor.env) stays root-owned, mode
#   600, exactly as it is today: trainee-measure is neither root nor
#   in its group, so the file is unreadable to this process by
#   filesystem construction, and the variant's code never tries.
# - The Environment below is the complete environment: the egress
#   proxy block and the Chromium facts the drive surface needs
#   (mirroring the production board unit's recorded environment),
#   and nothing else. No production-database variable is declared.
# - The service's own operator config is a SEPARATE module
#   (/home/hatch/worker-config/board-measure-config.cjs — board API
#   secret + family verdicts only), owned root:trainee-measure mode
#   640 so this user can read its own config and nothing else's.
#
# Port: the measurement config binds 8473 (8471 is the production
# board service, 8472 the stopped smoke instance) — set in the
# config module, not here.
#
# TEMPLATE ONLY until the owner approves the host steps in
# docs/engine/RECOVERY-OPTIONS-2026-10-23.md. Do not install,
# enable, or start this unit under any standing instruction.
[Unit]
Description=Upmore career board service — MEASUREMENT host (submit-disabled variant; form mapping and evidence only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=on-failure
User=trainee-measure
WorkingDirectory=/home/hatch/workspace/upmore-v2-candidate
Environment=http_proxy=http://hatch-egress-proxy:3128
Environment=https_proxy=http://hatch-egress-proxy:3128
Environment=HTTP_PROXY=http://hatch-egress-proxy:3128
Environment=HTTPS_PROXY=http://hatch-egress-proxy:3128
Environment=NODE_USE_ENV_PROXY=1
Environment=NODE_EXTRA_CA_CERTS=/run/hatch/egress-tls/ca-bundle.pem
Environment=SSL_CERT_FILE=/run/hatch/egress-tls/ca-bundle.pem
Environment=NO_PROXY=127.0.0.1,localhost
Environment=no_proxy=127.0.0.1,localhost
Environment=UPMORE_CHROMIUM_SANDBOX=off
Environment=UPMORE_CHROMIUM_PATH=/home/hatch/worker-config/chromium-egress-wrapper.sh
ExecStart=/usr/bin/node workers/career-browser/board-service-measure.cjs /home/hatch/worker-config/board-measure-config.cjs

[Install]
WantedBy=multi-user.target
