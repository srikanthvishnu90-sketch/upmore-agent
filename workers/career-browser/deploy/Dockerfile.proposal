# NOT BUILT OR DEPLOYED. Owner must provide an approved digest-pinned image
# already containing Node 24, a tested Playwright/Chromium pair and a non-root
# UID 1000. No browser download, package install, chmod/chown, extra capability,
# seccomp relaxation, or sandbox-disabling option occurs in this Dockerfile.
ARG UPMORE_BROWSER_BASE_IMAGE
FROM ${UPMORE_BROWSER_BASE_IMAGE}
WORKDIR /app
COPY workers/career-browser /app/workers/career-browser
COPY packages/domain/121-career-jobs.js packages/domain/122-career-profile.js packages/domain/132-career-apply.js packages/domain/148-career-render.js packages/domain/149-career-portal-apply.js packages/domain/150-career-portal-browser.js packages/domain/151-career-alert-watch.js /app/packages/domain/
COPY scripts/career/portal-browser-helper.cjs /app/scripts/career/
COPY supabase/functions/_shared/career_research_policy.js /app/supabase/functions/_shared/
COPY tests/career-owned-worker-browser.test.cjs tests/career-greenhouse-native-browser.test.cjs /app/tests/
COPY tests/fixtures/owned-worker-authority.cjs tests/fixtures/owned-portal.cjs /app/tests/fixtures/
COPY tests/fixtures/greenhouse-native/equipment.cjs tests/fixtures/greenhouse-native/manifest.cjs tests/fixtures/greenhouse-native/server.cjs tests/fixtures/greenhouse-native/form.html /app/tests/fixtures/greenhouse-native/
USER 1000:1000
# /etc/upmore/worker.cjs is separately mounted owner configuration. Secrets
# belong in the provider's approved secret binding, never the image or argv.
ENTRYPOINT ["node","/app/workers/career-browser/run.cjs"]
CMD ["/etc/upmore/worker.cjs"]
