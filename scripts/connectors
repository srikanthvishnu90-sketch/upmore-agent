#!/usr/bin/env node
// Connector catalog CLI (Instinct spec doc 05).
//   scripts/connectors --list              the catalog grouped by wave
//   scripts/connectors --check             validate every row; exit 1 on any error
//   scripts/connectors --can <surface>     "what can you connect": rows whose display name or domain matches
const fs = require("node:fs");
const path = require("node:path");
const root = path.resolve(__dirname, "..");
const Catalog = require(path.join(root, "packages/domain/52-connector-catalog.js"));
const catalog = JSON.parse(fs.readFileSync(path.join(root, "packages/connectors/catalog.json"), "utf8"));
const registry = JSON.parse(fs.readFileSync(path.join(root, "packages/capabilities/registry.json"), "utf8"));
const args = process.argv.slice(2), flag = n => { const i = args.indexOf(n); return i >= 0 ? (args[i + 1] || true) : null; };
const errors = Catalog.validate(catalog, registry);
if (flag("--check")) { if (errors.length) { console.error("Catalog invalid:\n" + errors.join("\n")); process.exit(1); } console.log(`Catalog valid: ${catalog.connectors.length} connectors, ${new Set(catalog.connectors.flatMap(c => c.capabilities)).size} capabilities powered`); process.exit(0); }
if (errors.length) { console.error("Catalog invalid:\n" + errors.join("\n")); process.exit(1); }
if (flag("--can")) { const a = Catalog.answer(catalog, String(flag("--can"))); console.log(a.text); process.exit(0); }
for (const wave of [1, 2, 3]) {
  console.log(`\nWave ${wave}: ${{ 1: "money in, money out", 2: "assets and debts", 3: "the long tail" }[wave]}`);
  for (const c of catalog.connectors.filter(c => c.wave === wave)) console.log(`  ${c.provider.padEnd(22)} ${c.auth_method.padEnd(20)} ${c.domain.padEnd(36)} ${c.capabilities.length} caps${c.write_actions.length ? `, ${c.write_actions.length} write actions (gated)` : ""}${c.gated_reason ? "  GATED: " + c.gated_reason : ""}${c.adapter_state !== "none" ? "  [" + c.adapter_state + "]" : ""}`);
}
console.log(`\n${catalog.connectors.length} connectors; adapters today: ${catalog.connectors.filter(c => c.adapter_state !== "none").length}; the rest are catalog rows with no adapter yet.`);
