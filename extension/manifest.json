{
  "manifest_version": 3,
  "name": "Trainee apply (Upmore)",
  "version": "0.1.0",
  "description": "Fills Greenhouse, Lever and Ashby applications from your confirmed facts; you review each card and approve it with one tap.",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Trainee apply" },
  "side_panel": { "default_path": "panel.html" },
  "permissions": ["storage", "unlimitedStorage", "tabs", "scripting", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://boards.eu.greenhouse.io/*",
        "https://job-boards.eu.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkdaysite.com/*",
        "https://*.myworkday.com/*"
      ],
      "js": ["lib/trainee-core.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
