  "$id": "https://upmore.example/contracts/journey-contract-v1.schema.json",
  "title": "Frozen Career Journey v1 boundary",
  "oneOf": [
    {
      "$ref": "#/$defs/CareerContextSnapshotV1"
    },
    {
      "$ref": "#/$defs/JourneyEventV1"
    },
    {
      "$ref": "#/$defs/JourneyTransitionV1"
    },
    {
      "$ref": "#/$defs/CareerActionProposalV1"
