{
  "manifest_version": 3,
  "name": "Trainee apply (Upmore)",
  "version": "0.2.0",
  "description": "Fills Greenhouse, Lever, Ashby and Workday job applications from answers you confirmed. Nothing is sent until you approve it.",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Trainee apply",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "side_panel": { "default_path": "panel.html" },
  "permissions": ["storage", "unlimitedStorage", "scripting", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://boards.eu.greenhouse.io/*",
        "https://job-boards.eu.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkdaysite.com/*",
        "https://*.myworkday.com/*"
      ],
      "js": ["lib/trainee-core.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
