#!/usr/bin/env python3
"""Validate references and derive readiness; catalog validity is not parity."""
import argparse
import csv
import hashlib
import importlib.util
import json
from pathlib import Path
import sys
import subprocess

ROOT=Path(__file__).resolve().parents[1]
STATUSES={'DISCOVERED','SPECIFIED','BUILT-LOCAL','SANDBOX-VERIFIED','LIVE-VERIFIED','PARTIAL','BLOCKED-PARTNER','BLOCKED-LEGAL','BLOCKED-OWNER','INTENTIONALLY-NOT-SHIPPED'}
PRESENCE={'PRESENT','CONDITIONAL','NOT FOUND','UNVERIFIED'}
BASELINE={'CA':32,'GW':22,'CH':27,'VE':24,'CO':27,'PR':21,'PP':25,'BA':21,'FC':20,'WF':22}
APP_SOURCES={'CA':{'S02','S03','S04'},'GW':{'S05','S06'},'CH':{'S07'},'VE':{'S08','S09','S10'},'CO':{'S11'},'PR':{'S12','S13','S14'},'PP':{'S15','S16'},'BA':{'S17'},'FC':{'S18','S19'},'WF':{'S20','S21'}}
APP_NAMES=dict(zip(BASELINE,('Cash App','Google','Chase','Venmo','Capital One','Propel','PayPal','Bank of America','Freecash','Wells Fargo')))
REQUIRED={'id','record_type','parent_id','app_ids','source_ids','source_passages','competitor_presence','outcome','entry_points','happy_path','variants','ui_states','input_schema','output_schema','source_of_truth','owner_scope','auth_and_consent','eligibility','fees_and_limits','upstream_partner','dependencies','data_freshness','risk_tier','implementation_files','tests','failure_and_recovery','telemetry','user_copy','screenshots','status','delivery_mode','evidence_ids','launch_gates','next_step','known_gaps'}
CONTRACT={'entry_points','happy_path','ui_states','input_schema','output_schema','source_of_truth','owner_scope','auth_and_consent','eligibility','fees_and_limits','data_freshness','risk_tier','failure_and_recovery','telemetry','user_copy'}

def source_digest():
    spec=importlib.util.spec_from_file_location('capture',ROOT/'scripts/capture-checks.py')
    module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)
    return module.source_digest()

def local_file(root,value):
    if not isinstance(value,str):return None
    path=(root/value).resolve()
    return path if path.is_relative_to(root.resolve()) and path.is_file() else None

def validate(root,catalog,sources,ledger,current_digest,current_commit=None):
    errors=[];features=catalog.get('features',[]);source_rows=sources.get('sources',[])
    ids=[f.get('id') for f in features];source_ids=[s.get('id') for s in source_rows]
    if len(ids)!=len(set(ids)):errors.append('Duplicate feature IDs.')
    if len(source_ids)!=len(set(source_ids)):errors.append('Duplicate source IDs.')
    indexed={s['id']:s for s in source_rows};evidence={e['id']:e for e in ledger.get('checks',[])}
    if len(evidence)!=len(ledger.get('checks',[])):errors.append('Duplicate evidence IDs.')
    cohort={c['id']:c for c in catalog.get('cohort',[])}
    if {app:c.get('seed_count') for app,c in cohort.items()}!=BASELINE or [c.get('id') for c in catalog.get('cohort',[])]!=list(BASELINE):errors.append('Fixed ten-app/241-seed baseline missing or altered.')
    for app,info in cohort.items():
        expected={f'{app}-{n:03d}' for n in range(1,info['seed_count']+1)}
        actual={f['id'] for f in features if f.get('record_type')=='seed' and f.get('app_ids')==[app]}
        if expected!=actual:errors.append(f'{app}: missing or altered baseline seeds.')
    for source in source_rows:
        note=source.get('local_note')
        if note and hashlib.sha256(note.encode()).hexdigest()!=source.get('local_note_sha256'):errors.append(f"{source['id']}: observation note hash mismatch.")
    valid_evidence=set()
    for item in evidence.values():
        path=local_file(root,item.get('log'))
        intact=bool(path) and hashlib.sha256(path.read_bytes()).hexdigest()==item.get('log_sha256')
        complete=all(item.get(k) for k in ('command','commit','source_digest','observed_at','environment'))
        if not intact:errors.append(f"{item['id']}: missing or changed evidence log.")
        if not complete:errors.append(f"{item['id']}: incomplete reproducibility record.")
        if item.get('result')=='PASS' and item.get('exit_code')!=0:errors.append(f"{item['id']}: passing evidence has nonzero or missing exit code.")
        if intact and complete and item.get('result')=='PASS' and item.get('exit_code')==0 and item.get('source_digest')==current_digest and (current_commit is None or item.get('commit')==current_commit):valid_evidence.add(item['id'])
    readiness={}
    for f in features:
        fid=f['id'];missing=REQUIRED-set(f)
        if missing:errors.append(f'{fid}: missing fields {sorted(missing)}.')
        if f.get('status') not in STATUSES:errors.append(f'{fid}: invalid status.')
        if not f.get('source_ids') or any(s not in indexed for s in f.get('source_ids',[])):errors.append(f'{fid}: missing source reference.')
        if f.get('parent_id') and f['parent_id'] not in ids:errors.append(f'{fid}: missing parent.')
        if f.get('record_type') not in ('seed','atomic','discovery'):errors.append(f'{fid}: invalid record type.')
        if f.get('record_type')=='atomic' and f.get('parent_id') and next((p.get('record_type') for p in features if p['id']==f['parent_id']),None) not in ('seed','discovery'):errors.append(f'{fid}: atomic parent must be a seed or discovery.')
        if any(app not in cohort for app in f.get('app_ids',[])):errors.append(f'{fid}: unknown competitor.')
        passages=f.get('source_passages',[])
        for passage in passages:
            source=indexed.get(passage.get('source_id'),{})
            scope=passage.get('support_scope') or (passage.get('kind') if passage.get('kind')=='PUBLIC-CLAIM' and passage.get('authenticated_behavior')=='UNVERIFIED' else None)
            if not source.get('observed_at') or not passage.get('locator') or not scope:errors.append(f'{fid}: unobserved or incomplete passage.')
            if passage.get('source_id') not in f.get('source_ids',[]):errors.append(f'{fid}: passage source is not associated with feature.')
        for app,status in f.get('competitor_presence',{}).items():
            if app not in cohort or status not in PRESENCE:errors.append(f'{fid}: invalid competitor presence.')
            supporting=[p for p in passages if p.get('source_id') in APP_SOURCES.get(app,set())
                        or app in indexed.get(p.get('source_id'),{}).get('app_ids',[])
                        or indexed.get(p.get('source_id'),{}).get('app')==APP_NAMES.get(app)]
            if status in ('PRESENT','CONDITIONAL') and not supporting:errors.append(f'{fid}: competitor claim lacks observed passage for {app}.')
        for path in f.get('implementation_files',[])+f.get('screenshots',[])+[p for paths in f.get('tests',{}).values() for p in paths]:
            if not local_file(root,path):errors.append(f'{fid}: missing or unsafe local reference {path}.')
        if any(e not in evidence for e in f.get('evidence_ids',[])):errors.append(f'{fid}: missing test evidence.')
        contract=all(f.get(field) is not None and f.get(field)!=[] and f.get(field)!={} for field in CONTRACT)
        contract=contract and all(isinstance(f.get(field),dict) and bool(f[field]) for field in ('input_schema','output_schema')) and f.get('risk_tier') in {f'R{i}' for i in range(6)}
        if f.get('status')=='SPECIFIED' and not contract:errors.append(f'{fid}: incomplete specification.')
        proofs=[evidence[e] for e in f.get('evidence_ids',[]) if e in evidence]
        # A suite PASS alone is not evidence that this feature was exercised. The
        # proof must bind its feature, test paths and screenshot artifacts.
        fresh=[p for p in proofs if p['id'] in valid_evidence and fid in p.get('feature_ids',[])]
        research=bool(passages) and all(indexed.get(p.get('source_id'),{}).get('observed_at') for p in passages)
        software=(f.get('record_type')=='atomic' and contract and bool(f.get('implementation_files'))
                  and all(f.get('tests',{}).get(t) for t in ('unit','contract','integration','browser'))
                  and bool(f.get('screenshots')) and bool(fresh)
                  and all(any(path in p.get('test_files',[]) for p in fresh) for paths in f.get('tests',{}).values() for path in paths)
                  and any(p.get('verification_level')=='BROWSER' and p.get('provider_mode') in ('synthetic','local','provider-sandbox','production')
                          and all(path in p.get('screenshots',[]) and local_file(root,path)
                                  and hashlib.sha256(local_file(root,path).read_bytes()).hexdigest()==p.get('screenshot_sha256',{}).get(path)
                                  for path in f.get('screenshots',[])) for p in fresh))
        sandbox=software and any(p.get('verification_level')=='SANDBOX' and p.get('provider_mode')=='provider-sandbox' and p.get('provider_reference') for p in fresh)
        gates=f.get('launch_gates',[])
        gate_ready=bool(gates) and all(isinstance(g,dict) and g.get('status')=='CLEARED' and g.get('evidence_id') in valid_evidence
          and evidence[g['evidence_id']].get('verification_level')=='LAUNCH-APPROVAL'
          and fid in evidence[g['evidence_id']].get('feature_ids',[]) for g in gates)
        # Local calculations/drafts need no external launch approval. This says
        # nothing about operational provider coverage or production readiness.
        local_only=f.get('risk_tier') in ('R0','R2') and f.get('upstream_partner') in (None,'none') and f.get('delivery_mode')=='NATIVE-LOCAL'
        if local_only and not gates:gate_ready=software
        live=sandbox and gate_ready and any(p.get('verification_level')=='LIVE' and p.get('provider_mode')=='production' and p.get('provider_reference') for p in fresh)
        # Never allow a manually edited status to outrun the underlying packet.
        if f.get('status')=='BUILT-LOCAL' and not software:errors.append(f'{fid}: local completion not proved.')
        if f.get('status')=='SANDBOX-VERIFIED' and not sandbox:errors.append(f'{fid}: sandbox completion not proved.')
        if f.get('status')=='LIVE-VERIFIED' and not live:errors.append(f'{fid}: live completion not proved; mocks/local checks cannot certify live.')
        readiness[fid]={'research':research,'software':software,'provider':sandbox,'launch':gate_ready,'live':live}
    seeds=[f for f in features if f.get('record_type')=='seed']
    discoveries=[f for f in features if f.get('record_type')=='discovery']
    atomics=[f for f in features if f.get('record_type')=='atomic']
    def expanded(seed,children):
        declared=seed.get('atomic_requirement_ids',[])
        reviews=[evidence[e] for e in seed.get('coverage_evidence_ids',[]) if e in valid_evidence]
        return bool(children) and set(declared)=={c['id'] for c in children} and any(
            p.get('verification_level')=='SPECIFICATION-REVIEW' and seed['id'] in p.get('feature_ids',[])
            and set(p.get('atomic_requirement_ids',[]))==set(declared) for p in reviews)
    def total(key,parents):return sum(expanded(f,children) and all(readiness[c['id']][key] for c in children) for f in parents if (children:=[a for a in atomics if a.get('parent_id')==f['id']]))
    summary={'baseline_seeds':len(seeds),'atomic_records':len(atomics),'total_records':len(features),
      'additional_discoveries':len(discoveries),'full_outcome_denominator':len(seeds)+len(discoveries),
      'inventory_complete':catalog.get('inventory_complete') is True,
      'research_verified_records':sum(r['research'] for r in readiness.values()),
      'full_seed_outcomes':{key:{'verified':total(key,seeds),'denominator':len(seeds)} for key in ('software','provider','launch','live')},
      'full_discovered_outcomes':{key:{'verified':total(key,seeds+discoveries),'denominator':len(seeds)+len(discoveries)} for key in ('software','provider','launch','live')},
      'software_ready_atoms':{'verified':sum(readiness[f['id']]['software'] for f in atomics),'denominator':len(atomics)},
      'notice':'Reference validation is not financial parity. Blocked and unexpanded seeds remain in the full denominator.'}
    summary['proof_limitations']='Hashes detect artifact changes, not fabricated provenance. Feature-scoped test/screenshot references and reviewed atomic expansion require human review; inventory_complete is a declaration, not a completion score.'
    return errors,summary,readiness

def main():
    parser=argparse.ArgumentParser();parser.add_argument('--write',action='store_true');args=parser.parse_args()
    catalog=json.loads((ROOT/'docs/competition/features.json').read_text())
    sources=json.loads((ROOT/'docs/competition/sources.json').read_text())
    ledger=json.loads((ROOT/'docs/testing/evidence-ledger.json').read_text())
    commit=subprocess.check_output(['git','rev-parse','HEAD'],cwd=ROOT,text=True).strip()
    errors,summary,readiness=validate(ROOT,catalog,sources,ledger,source_digest(),commit)
    if args.write and not errors:
        apps=[c['id'] for c in catalog['cohort']]
        with (ROOT/'docs/competition/parity-matrix.csv').open('w',newline='') as stream:
            writer=csv.writer(stream);writer.writerow(['id','parent','outcome',*apps,'Upmore','mode','gaps'])
            for f in catalog['features']:writer.writerow([f['id'],f['parent_id'],f['outcome'],*[f['competitor_presence'].get(app,'UNVERIFIED') for app in apps],f['status'],f['delivery_mode'],'; '.join(f['known_gaps'])])
        (ROOT/'docs/competition/readiness.json').write_text(json.dumps(summary,indent=2)+'\n')
        page=['# Upmore parity inventory','',summary['notice'],'',f"{summary['baseline_seeds']} baseline seeds; {summary['atomic_records']} atomic records. Atomic expansion remains incomplete.",'', '| ID | Outcome | Upmore | Remaining gap |','| --- | --- | --- | --- |']
        for f in catalog['features']:page.append(f"| {f['id']} | {f['outcome']} | {f['status']} | {'; '.join(f['known_gaps'])} |")
        (ROOT/'docs/competition/parity-matrix.md').write_text('\n'.join(page)+'\n')
    print(json.dumps({'errors':errors,'readiness':summary},indent=2))
    return bool(errors)

if __name__=='__main__':sys.exit(main())
