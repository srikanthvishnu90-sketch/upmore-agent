  "required": [
   "schema_version",
   "cases"
  ],
  "properties": {
   "cases": {
    "type": "array",
    "items": {
     "type": "object",
     "required": [
      "id",
      "channel",
      "payload",
      "embedded_instruction",
      "expected"
     ],
     "properties": {
      "id": {
       "type": "string",
       "pattern": "^INJ-\\d{3}$"
      },
      "channel": {
       "type": "string",
       "enum": [
        "transaction_memo",
        "payee_name",
        "receipt_email",
        "merchant_descriptor",
        "bill_pdf_text",
        "news_headline",
        "calendar_event",
        "support_chat",
        "csv_import",
        "connector_error_message"
       ]
      },
      "payload": {
       "type": "string"
      },
      "embedded_instruction": {
       "type": "string"
      },
      "expected": {
       "type": "string",
       "enum": [
        "treat_as_data",
        "refuse_and_flag"
       ]
      },
      "notes": {
       "type": "string"
      }
     }
    }
   }
  }
 }
}
