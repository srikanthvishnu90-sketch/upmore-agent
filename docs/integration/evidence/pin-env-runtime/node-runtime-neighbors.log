  actual: |-
    name: ci
    on:
      push:
      pull_request:
    permissions:
      contents: read
    jobs:
      gate:
        env:
          TZ: UTC
        runs-on: ubuntu-24.04
        # The gate took 9.3-9.6 min on #62 (2026-10-20), its career-and-shared step alone 520-537 s; at 10 the next test
        # cancelled it (5470fe98). Consolidating the fix line onto trunk (PR #156) added ~270 tests and the 15-minute cap
        # cancelled the first run. Headroom, not a target: a slower gate is still a finding.
        timeout-minutes: 30
        steps:
          - uses: actions/checkout@v4
          - uses: actions/setup-node@v4
            with: { node-version-file: ".node-version" }
          - uses: denoland/setup-deno@v2
            with: { deno-version-file: ".deno-version" }
          - uses: actions/setup-python@v5
            with: { python-version-file: ".python-version" }
          - name: Install tooling and use the runner's packaged Chrome
            run: |
              # The versions come from tools/package.json + tools/package-lock.json, the same pins the career browser worker installs
              # with `npm ci` (F-032: the worker's Playwright and the tests' differed, so a guard passed while the driver threw).
              npm ci --prefix tools --no-audit --no-fund
              npm ci --prefix packages/extension/tools --no-audit --no-fund
              # WO-031: an unpacked extension loads only in Chromium (branded Chrome ignores --load-extension); the extension
              # suite (tests/career-extension-browser.test.cjs) finds Playwright's own Chromium through UPMORE_PLAYWRIGHT_PATH.
              (cd tools && npx --no-install playwright install chromium)
              browser_path=$(command -v google-chrome)
              test -x "$browser_path"
              echo "UPMORE_PLAYWRIGHT_PATH=$GITHUB_WORKSPACE/tools/node_modules/playwright" >> "$GITHUB_ENV"
              echo "UPMORE_CHROMIUM_PATH=$browser_path" >> "$GITHUB_ENV"
              echo "ESBUILD_BIN=$GITHUB_WORKSPACE/tools/node_modules/.bin/esbuild" >> "$GITHUB_ENV"
              # The pay-data importer tests read a real .xlsx (WO-036); a venv keeps the runner's system Python untouched.
              python3 -m venv "$RUNNER_TEMP/py"
              "$RUNNER_TEMP/py/bin/pip" install --quiet openpyxl==3.1.5
              echo "$RUNNER_TEMP/py/bin" >> "$GITHUB_PATH"
          - name: Allow sandboxed Chromium user namespaces for this gate job
            run: sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0
          - name: Career gate
            # The gate's result is also written as annotations (readable through the checks API, where a job log may not
            # be): the step summary lines, then the failing tests' names.
            run: |
              set -o pipefail
              bash scripts/gate.sh 2>&1 | tee "$RUNNER_TEMP/gate.log"
          - name: Gate result as annotations
            if: always()
            run: |
              test -f "$RUNNER_TEMP/gate.log" || exit 0
              summary=$(grep -E '^SUMMARY ' "$RUNNER_TEMP/gate.log" | sed 's/^SUMMARY //' | head -20)
              [ -n "$summary" ] && echo "::notice title=gate steps::$(printf '%s' "$summary" | sed ':a;N;$!ba;s/\n/%0A/g')"
              failed=$( { grep -E '^\s*not ok [0-9]+ - ' "$RUNNER_TEMP/gate.log" | sed -E 's/^\s*not ok [0-9]+ - //'; sed 's/\x1b\[[0-9;]*m//g' "$RUNNER_TEMP/gate.log" | grep -E ' => [^ ]+:[0-9]+:[0-9]+' ; } | sort -u | head -40)
              [ -n "$failed" ] && echo "::error title=gate failing tests::$(printf '%s' "$failed" | cut -c1-180 | sed ':a;N;$!ba;s/\n/%0A/g')"
              # Deno's own errors (load failures, type errors), which are not TAP lines; color codes stripped.
              sed 's/\x1b\[[0-9;]*m//g' "$RUNNER_TEMP/gate.log" | grep -E '^error: |TS[0-9]+ \[ERROR\]|^ERRORS?$|FAILED \(exit' | head -10 | while read -r l; do echo "::error title=gate error::$(printf '%s' "$l" | cut -c1-300)"; done
              exit 0
      database:
        runs-on: ubuntu-24.04
        env:
          TZ: UTC
        steps:
          - uses: actions/checkout@v4
          - uses: actions/setup-python@v5
            with: { python-version-file: ".python-version" }
          - name: Migrations, RLS and SQL tests on a throwaway Postgres 16, plus the migration ledger
            run: PGBIN=/usr/lib/postgresql/16/bin PATH=/usr/lib/postgresql/16/bin:$PATH bash tests/db/run.sh
    
